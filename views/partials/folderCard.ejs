<% if (locals.folders) {%>
  <div class="folder-div">
    <% folders.forEach((folder)=>{%>
      <div>
        Folder name: <%= folder.foldername%>

          <% if(folder.filename.length> 0){%>
            <div>
              Number of files in this folder: <%= folder.filename.length%>

            </div>
            <a href="/files/<%=folder.id%>">Show folder contents</a>
            <%} else {%>
              <div>This folder is emtpy.</div>
              <%}})%>

      </div>



  </div>

  <% } %>