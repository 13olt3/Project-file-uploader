<div class="folder-div">

  <div>
    Currently in: <%= fileData.foldername%> folder.

      <div class="file-div">
        <% fileData.filename.forEach((fileData)=> { %>

          <div class="file-card">
            <p>File name: <%= fileData.filename %>
            </p>
            <p>File size: <%= Math.round((fileData.size)/1024) %>KB
            </p>
            <p><a href="<%= fileData.downloadUrl%>">Show file</a>
            </p>
            <a href="/delete/<%=fileData.id%>"
              onclick="return confirm('Are you sure you want to delete this file? This cannot be undone.')">Delete
              file</a>


          </div>

          <% }); %>
      </div>

  </div>

</div>