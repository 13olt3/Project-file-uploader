<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title%>
  </title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="dash-board">

    <%= title%>
      <%- include("partials/errors.ejs") %>
        <%- include('partials/nav') %>

          <% if (locals.user){%>
            <%= locals.user.username%>
              <%}%>

  </div>
  <div class="main-content">


    <% if (locals.user){%>
      <div> Create new directory:
        <form action="/createFolder" method="post" autocomplete="off">
          <label for="newFolder">Directory Name:</label>
          <input type="text" id="newFolder" name="newFolder">
          <button>Create new directory</button>
        </form>
      </div>
      <div>
        <div>Or, choose existing directory:</div>
        <%folders.forEach((folder)=>{%>
          <div><a href="/upload/<%=folder.id%>">
              <%=folder.foldername%>
            </a></div>

          <%})%>
            <%}%>

      </div>



  </div>

</body>

</html>