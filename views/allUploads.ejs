<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title%>
  </title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="dash-board">

    <%= title%>
      <%- include("partials/errors.ejs") %>
        <%- include('partials/nav') %>

          <% if (locals.user){%>
            <%= locals.user.username%>
              <%}%>

  </div>
  <div class="main-content">
    <div>
      <% folders.forEach(folder=> { %>
        <div>
          <h3>
            <%= folder.foldername %>
          </h3>

          <% if (folder.filename.length> 0) { %>
            <div class="file-list">
              <% folder.filename.forEach(file=> { %>
                <div class="file-card">
                  <p>Name: <%= file.filename %>
                  </p>
                  <p>Size: <%= Math.round((file.size / 1024)) %> KB</p>
                  <a href="<%= file.downloadUrl %>">Show file</a>
                </div>
                <% }) %>
            </div>
            <% } else { %>
              <p class="empty-msg">This folder is empty.</p>
              <% } %>
        </div>
        <% }) %>


    </div>

  </div>

</body>

</html>